# Copy to .env.local and adjust. Variables starting with EXPO_PUBLIC_ are bundled into the app.

# Plan server the app checks for physician plans (demo relay: npm run relay).
# Web preview defaults to http://localhost:8787. For a phone with Expo Go on the
# same Wi-Fi, use the laptop's IP address, e.g. http://192.168.1.20:8787
EXPO_PUBLIC_PLAN_SERVER_URL=http://localhost:8787
